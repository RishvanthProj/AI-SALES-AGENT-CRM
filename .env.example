# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# AI Provider ("gemini" or "claude")
AI_PROVIDER=gemini

# Google Gemini API Configuration (Server-Side ONLY)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Claude API Configuration (Compatibility fallback)
ANTHROPIC_API_KEY=sk-ant-api03-placeholder-key-here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Firebase / Firestore Configuration (Source of Truth for Business Data)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CREDENTIALS_PATH=
FIRESTORE_DATABASE_ID=(default)
USE_FIREBASE_EMULATOR=false
FIRESTORE_EMULATOR_HOST=localhost:8080

# PostgreSQL Database (Tenant infrastructure & auth metadata)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/whatsapp_sales_db
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/whatsapp_sales_db

# WhatsApp Business Cloud API Configuration
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret_for_hmac
WHATSAPP_API_VERSION=v20.0
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
